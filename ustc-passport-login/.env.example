# 中国科大统一身份认证登录配置
# 本文件已被本仓库 .gitignore（**/.env）忽略，不会被提交、不会被推送。
# 含明文口令：不要复制到任何会被同步/提交的目录，不要贴进对话或日志。

# ── 必填 ──────────────────────────────────────────────────────────────
# 学号 / 工资号 / 一卡通 GID
USTC_USERNAME=
USTC_PASSWORD=

# ── 登录目标：下面两个至少填一个，同时填时 USTC_ENTRY 优先 ──────────────
#
# ① USTC_SERVICE：应用在 CAS 注册的服务地址（多数应用走这个）
#    已知可用：
#      https://www.ustc.edu.cn/                     学校主页（最简单的连通性自检）
#      https://jw.ustc.edu.cn/ucas-sso/login        教务系统（ITDR 网关）
#      https://weixine.ustc.edu.cn/2020/caslogin    健康打卡
#    别的应用不要猜裸域名（会回「应用未对接认证服务」）：
#    打开该应用，找「统一身份认证登录」按钮，抄它的真实链接。
USTC_SERVICE=

# ② USTC_ENTRY：应用的统一登录入口（OIDC / PKCE 应用用这个）
#    已知可用：
#      https://id.ustc.edu.cn/tokenworks/credits/auth/login    词元工坊共享额度
USTC_ENTRY=

# ── 可选 ──────────────────────────────────────────────────────────────
# 单次请求超时（秒），默认 20
USTC_TIMEOUT=20
